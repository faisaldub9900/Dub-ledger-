NODE_ENV=development
HOST=127.0.0.1
PORT=8080
# Set this to the exact frontend origin before enabling browser access.
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection string. Keep real credentials in a private .env file.
DATABASE_URL=postgresql://dub_app:change_me@127.0.0.1:5432/dub_ledger
DB_POOL_MAX=10
# Set true only when the database provider requires verified TLS.
DATABASE_SSL=false
