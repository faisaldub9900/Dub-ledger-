NODE_ENV=development
HOST=127.0.0.1
PORT=8080
CORS_ORIGIN=http://localhost:3000

# Keep real credentials only in a private environment/secret manager.
DATABASE_URL=postgresql://dub_app:change_me@127.0.0.1:5432/dub_ledger
DB_POOL_MAX=10
DATABASE_SSL=false
SESSION_HOURS=12

# Generate a random 32-byte key and base64-encode it; keep it secret and backed up.
# Example: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=

# Temporarily provide these privately for the one-time Owner bootstrap only.
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=
